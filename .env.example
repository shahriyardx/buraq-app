# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/buraq?schema=public"

# better-auth
BETTER_AUTH_SECRET="change-me-generate-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="buraq"
# Public base URL for the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_URL="https://pub-xxxxxxxx.r2.dev"

# Resend
RESEND_API_KEY=""
RESEND_FROM="Buraq Horse Riding School <noreply@example.com>"
